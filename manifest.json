{
  "manifest_version": 3,
  "name": "Folio Research Notebook",
  "version": "0.1.0",
  "description": "Research questions, sources, notes, and a focused evidence map.",
  "minimum_chrome_version": "116",
  "key": "",
  "host_permissions": ["http://127.0.0.1:43127/*"],
  "permissions": ["sidePanel"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Folio Research Notebook"
  },
  "side_panel": {
    "default_path": "index.html"
  }
}
